# Copy to .env and fill in real values. .env is gitignored; .env.example is committed.

# OpenCode AI Provider
OPENCODE_API_KEY=your-opencode-api-key
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_MODEL=deepseek-v4.1-flash

# Supabase project (same one the frontend uses) — Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# Unsplash access key — https://unsplash.com/developers (Create app → Access Key)
UNSPLASH_ACCESS_KEY=your-unsplash-access-key

# Shared secret token with Next.js BFF proxy (leave unset/empty for local dev)
# INTERNAL_API_SECRET=your-shared-internal-secret-token
