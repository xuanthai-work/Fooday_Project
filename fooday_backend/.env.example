# Copy to .env and fill in real values. .env is gitignored; .env.example is committed.

# Google AI Studio (Gemini) API key — https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Supabase project (same one the frontend uses) — Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# Unsplash access key — https://unsplash.com/developers (Create app → Access Key)
UNSPLASH_ACCESS_KEY=your-unsplash-access-key
