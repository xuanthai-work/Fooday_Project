{
  "name": "fooday_frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "npm run test:taxonomy && npm run test:reel && npm run test:popularity",
    "test:taxonomy": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/test-taxonomy.mjs",
    "test:reel": "node --experimental-strip-types scripts/test-reel.mjs",
    "test:popularity": "node --experimental-strip-types scripts/test-popularity.mjs",
    "watch:task": "powershell -ExecutionPolicy Bypass -File ../scripts/watch-and-inject.ps1"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "lucide-react": "^1.20.0",
    "motion": "^14.3.0",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "typescript": "^5"
  }
}
