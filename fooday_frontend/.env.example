# Copy this file to .env.local and fill in your real Supabase values.
# .env.local is gitignored; .env.example is committed as a template.
# Find both values in Supabase Dashboard → Project Settings → API.

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# anon / public key — safe to expose in the browser (protected by Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Backend (AI chat) base URL — defaults to http://localhost:2001/api/v1 if unset
# NEXT_PUBLIC_API_URL=http://localhost:2001/api/v1

# Backend (AI chat) URL for Next.js server-side BFF proxy
# BACKEND_INTERNAL_URL=https://fooday-backend.onrender.com/api/v1

# Shared secret token with FastAPI backend (optional for local dev)
# INTERNAL_API_SECRET=your-shared-internal-secret-token

# Optional: Direct public API URL (if bypass BFF proxy)
# NEXT_PUBLIC_API_URL=http://localhost:2001/api/v1
